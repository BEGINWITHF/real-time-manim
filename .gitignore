# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- Build artifacts (compiled) ----
build/
dist/

# ---- PyPI packaging outputs (regenerable via `python -m build`) ----
dist/*.whl
dist/*.tar.gz
build/lib/
build/bdist.*/

# ---- Renderer runtime output ----
downloaded_videos/
media/
tex_cache/
frames/

# ---- RTM-Wiki regenerable render artefacts ----
# `final/` and `concat.txt` are the RTM runners' per-scene intermediates;
# a few are tracked from before this rule, which git keeps tracking.
RTM-Wiki/**/assets/RTM code/final/
RTM-Wiki/**/assets/RTM code/concat.txt
# ManimCE twins, generated by tools/make_ce_twin.py
RTM-Wiki/**/assets/ManimCE code/
RTM-Wiki/**/assets/ManimCE output/

# ---- MSVC build byproducts (build_msvc.bat) ----
*.obj
real_time_manim/vulkan_core.lib
real_time_manim/vulkan_core.exp

# ---- Local debug/bench scratch (not part of the project) ----
_hidden_check/

# ---- Local syntax-comparison scratch (not part of the project) ----
syntax_compare/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Not published in the remote repository ----
/tests/
/tools/
/docs/
/examples/
/run.py
/run_all.py
